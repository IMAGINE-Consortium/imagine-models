@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(ImagineModels_HAS_AUTODIFF @IMAGINE_HAS_AUTODIFF@)
set(ImagineModels_HAS_FFTW @IMAGINE_HAS_FFTW@)

if(ImagineModels_HAS_AUTODIFF)
    find_dependency(autodiff)
    find_dependency(Eigen3 NO_MODULE)
endif()

if(ImagineModels_HAS_FFTW)
    list(PREPEND CMAKE_MODULE_PATH ${CMAKE_CURRENT_LIST_DIR})
    find_dependency(FFTW COMPONENTS DOUBLE_LIB)
    list(POP_FRONT CMAKE_MODULE_PATH)
endif()

include(${CMAKE_CURRENT_LIST_DIR}/ImagineModelsTargets.cmake)
check_required_components(ImagineModels)
